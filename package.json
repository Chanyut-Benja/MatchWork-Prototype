{
  "name": "matchwork-prototype",
  "version": "1.0.0",
  "description": "Interactive Prototype for MatchWork - Tinder-style Tag-weighted Job Matching System",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "concurrently -n API,WEB -c blue,magenta \"node server.js\" \"npm --prefix client run dev\"",
    "dev:server": "node server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "cd client && npm install && npm run build",
    "build:client": "npm --prefix client run build",
    "test": "jest --verbose",
    "test:custom": "node src/tests/unitTests.js",
    "db:sync": "node src/database/sync.js",
    "db:seed": "node src/database/sync.js --seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jest": "^30.5.2"
  }
}
